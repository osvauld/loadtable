# Portable systemd USER unit template for a task-manager worker host.
# NOT installed by anything in this repository. Review, copy to
# ~/.config/systemd/user/tasks-daemon.service, then see README.md.
#
# The daemon is long-running (it serves taskd.sock and spawns the worker on
# demand). Without this unit, the first `tasks` client autostarts it with that
# client's environment, which may lack the TASKS_MIN_* settings below.
[Unit]
Description=task-manager daemon (tasks) with native admission
# No network dependency: clients reach it over SSH + the local Unix socket.

[Service]
Type=simple
# Path of the binary built for THIS host (see README). Clients must invoke the
# same binary, because `tasks` autostarts/spawns helpers via its own path.
ExecStart=%h/.local/bin/tasks daemon
WorkingDirectory=%h
UMask=0077
# Admitted commands inherit the daemon PATH (client PATH is not forwarded).
# Entries that do not exist on a host are harmless. NixOS paths included.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/run/wrappers/bin:/usr/local/bin:/usr/bin:/bin
# NixOS: system .pc files (nix/taskworker-host.nix links /lib/pkgconfig). Harmless elsewhere:
# pkg-config still searches its built-in system directories.
Environment=PKG_CONFIG_PATH=/run/current-system/sw/lib/pkgconfig
# Android/Gradle (passed through to admitted commands): the SDK for Gradle and for the
# local.properties auto-create, and the JDK. Enable only where these paths exist: the SDK
# is installed with Google's sdkmanager into ~/Android/Sdk (as on the main host), and the
# NixOS module links /etc/taskworker/jdk21.
#Environment=ANDROID_HOME=%h/Android/Sdk
#Environment=JAVA_HOME=/etc/taskworker/jdk21
# Test phone (README "Test phone on the worker"): device jobs use the SDK's adb as
# "$ANDROID_HOME"/platform-tools/adb. To let commands call plain `adb`, append
# %h/Android/Sdk/platform-tools to PATH above. Don't install a second adb
# (android-tools): two adb versions kill each other's server on port 5037.
# The daemon needs the adbusers group: restart the user manager after adding it.
# Admission thresholds (validated; invalid values make start-worker fail).
# Defaults when unset: 8192 MiB memory, 20 GiB cache disk, 256 MiB state disk.
# Example for a ~7.6 GiB RAM laptop; choose deliberately for your host.
Environment=TASKS_MIN_AVAILABLE_MEMORY_MIB=3072
#Environment=TASKS_MIN_CACHE_FREE_GIB=20
#Environment=TASKS_MIN_STATE_FREE_MIB=256
# Largest explicit Cargo -j/--jobs/CARGO_BUILD_JOBS a command may request
# (1..=64, default 2). Commands without -j still get CARGO_BUILD_JOBS=2.
# Only for a dedicated compute worker with RAM/cores to spare.
#Environment=TASKS_MAX_CARGO_JOBS=8
# Opt-in: let RUN slots admit up to this CPU PSI some avg10 (40..=100, default
# 40 = unchanged). Never relaxes compile, memory or I/O gates.
#Environment=TASKS_RUN_CPU_SOME_MAX_PCT=80
# Admission lock directory. Default /tmp/claude-$UID (shared with legacy
# clients). Override only if /tmp is age-cleaned and cannot be excluded; then
# legacy default-path clients are NOT coordinated. See README.md.
#Environment=TASKS_LOCK_DIR=%h/.local/state/tasks-locks
# Leave TASK_MANAGER_STATE_DIR unset: the default (~/.local/state/
# tinline-task-manager-native) is what SSH clients use too.
#
# Stopping the unit stops only the daemon. The worker and admitted jobs keep
# their own process groups and leases, as with today's autostarted daemon.
# Stopping is NOT cancellation. Restart with: tasks drain && systemctl --user restart
# tasks-daemon (drain pauses claims until the next daemon start; no admission window).
KillMode=process
# Restart after crashes/signals only. Errors (exit 2), e.g. "another daemon owns
# this state directory", are not retried in a loop.
Restart=on-abnormal
RestartSec=30
# Deliberately NO PrivateTmp/ProtectHome/ProtectSystem: the admission lock
# directory /tmp/claude-$UID, the state socket and live checkouts must be the
# same files that SSH clients see.

[Install]
WantedBy=default.target
